# Copy to .env and fill in. Never commit .env.

# Official Kroger Developer API (optional but recommended): store-level shelf + promo prices.
# Create an app at https://developer.kroger.com -> Production environment -> scope product.compact
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Anthropic API (optional): generates recipes around this week's sales.
# Without it, a built-in recipe library is used. Prices are always computed from real deal data.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# PORT=3000
# DEAL_TTL_HOURS=24        # how long ingested deals count as fresh
# KROGER_MAX_STORES=3      # nearest Kroger stores priced via the API per ZIP
# COVERAGE_MILES=60        # ZIPs farther than this from Dallas are rejected
